# Скопируйте в .env.local (локально) и в Vercel → Settings → Environment Variables.
# Здесь нет секретов: все значения ниже публичные по своей природе.
# service_role-ключ приложению НЕ нужен — не добавляйте его никуда.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (или legacy anon) ключ
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Адрес сайта (для ссылок в письмах и редиректов)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Часовой пояс для счётчика и дат (IANA)
NEXT_PUBLIC_TIMEZONE=UTC
